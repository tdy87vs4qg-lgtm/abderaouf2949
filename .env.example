# BacYesWeCan — environment variable NAMES only (no real values here).
# In production these are Cloudflare Pages secrets/vars, never committed.
# For local development, copy the relevant names into `.dev.vars`.

# --- Google Drive (server-side only — the key is NEVER sent to the browser) ---
# Copy this file to `.env` and fill GOOGLE_API_KEY. `.env` is the source of
# truth for local values; `scripts/sync-env.mjs` (run automatically before
# dev/build) projects the server-side keys into `.dev.vars` for wrangler.
GOOGLE_API_KEY=
# Root Drive folder id for the library (safe to commit — it is not a secret).
DRIVE_FOLDER_ID=1U1ZAJnNY6cZ9cC-sW05i7duZEPO-SL2M
# Secondary Drive folder that holds the real targets of the shortcut items
# placed in the main folder. Treated as an ADDITIONAL allowed source so those
# shortcuts resolve/preview/download normally. Safe to commit (not a secret).
# When unset the app falls back to the known secondary folder id in code.
SECONDARY_DRIVE_FOLDER_ID=1rLZJwRVGblUvAulzcEFT6T9xZ94ChzkQ

# --- CORS / site config ---
# Canonical site origin used to lock CORS on API routes (optional in dev).
SITE_ORIGIN=

# --- Auth (Task 4A — server-side only; NEVER sent to the browser) ---
# Random 32+ byte secret that keys session-token digests. In production this is
# a Cloudflare Pages secret: `wrangler pages secret put SESSION_SECRET`.
SESSION_SECRET=

# --- Admin bootstrap (Task 11 / deploy — server-side only) ---
# Credentials for the FIRST admin account. On the first login with this email
# the app idempotently provisions (or repairs) an active 'admin' row in D1, so
# production never depends on the dev seed. In production set these as secrets:
#   wrangler pages secret put ADMIN_SEED_EMAIL
#   wrangler pages secret put ADMIN_SEED_PASSWORD
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Note: when GOOGLE_API_KEY / DRIVE_FOLDER_ID are unset, the library
# renders clearly-labelled SAMPLE content so the UI stays fully browsable.

# --- Google OAuth 2.0 "Sign in with Google" (Part A: start leg,
#     Part B-1: callback receive leg) ---
# OAuth 2.0 CLIENT ID credentials from Google Cloud Console (APIs & Services →
# Credentials → OAuth 2.0 Client IDs). A DIFFERENT credential from the Drive
# service account above. Server-side only; never sent to the browser except the
# client id, which Google's spec requires inside the authorization URL.
# In production set them on the Pages project, e.g.:
#   wrangler pages secret put GOOGLE_OAUTH_CLIENT_ID
#   wrangler pages secret put GOOGLE_OAUTH_CLIENT_SECRET
#   wrangler pages secret put GOOGLE_OAUTH_REDIRECT_URI
GOOGLE_OAUTH_CLIENT_ID=
# TRUE SECRET — used ONLY by GET /api/auth/google/callback (Part B-1) for the
# server-to-server code→token exchange. Never logged, never returned in any
# response, never sent to the browser. Leave EMPTY here; put the real value in
# the git-ignored `.env` locally, and in a Cloudflare secret in production.
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match the redirect URI registered on the OAuth client byte-for-byte
# (Google re-validates it during the token exchange as well).
# Production example: https://tayseer-bac.pages.dev/api/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
